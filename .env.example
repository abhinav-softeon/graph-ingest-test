# Neo4j (independent instance/DB for this experimentation app)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword
NEO4J_DATABASE=neo4j

# Ingestion mode (also settable per-run via CLI flags / API form fields / UI checkboxes)
GRAPH_EXTRACT_BATCH_SIZE=2000
GRAPH_EXTRACT_WORKERS=
GRAPH_CHECKPOINT_ROOT=
GRAPH_STREAMING_INGEST=false
GRAPH_STREAMING_WRITER=false

# Optional subsystems
GRAPH_SCIP_ENABLED=false
GRAPH_EXTRACT_CACHE_ENABLED=true
GRAPH_EXTRACT_CACHE_DIR=.cache/graph_extract_cache

# Concurrency (the settings this app exists to experiment with)
GRAPH_CACHE_IO_WORKERS=16
GRAPH_ZIP_EXTRACT_WORKERS=
GRAPH_RESOLVE_WORKERS=1

# SCIP binaries (optional; only used when GRAPH_SCIP_ENABLED=true and installed)
SCIP_PYTHON_BIN=
SCIP_JAVA_BIN=
SCIP_JAVA_MAX_FILES=0

# Misc (inherited from graph_core/config.py, rarely need changing)
GRAPH_RESOLVE_CHUNK=250000
GRAPH_RESOLVE_CHECKPOINT_SECONDS=60
GRAPH_INDEX_LOCK_STALE_SECONDS=1800

# Logging
GRAPH_LOG_LEVEL=INFO
